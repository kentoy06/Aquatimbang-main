# Copy this file to backend/.env and fill in your own values.
# backend/.env is ignored by git, so your passwords stay private.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Remove DB_ENGINE (or leave it empty) to use a local SQLite file instead of MySQL.
DB_ENGINE=mysql
DB_NAME=aquatimbang_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Front-end sites allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://kentoy06.github.io

# Login security: idle logout (minutes), wrong-password limit, lock time (minutes).
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Email (password reset links, lockout notices). Leave EMAIL_HOST empty to
# print emails in the terminal instead of sending them.
# For Gmail: turn on 2-Step Verification, create an App Password, and use it below.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Address of the website, used in links inside emails.
FRONTEND_URL=http://localhost:5173/Aquatimbang-main/

# ---- Only when the backend is hosted online (see docs/DEPLOYMENT.md) ----
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
# CORS_ALLOWED_ORIGINS=https://kentoy06.github.io
# FRONTEND_URL=https://kentoy06.github.io/Aquatimbang-main/
# MEDIA_ROOT=/home/yourname/aquatimbang-media
